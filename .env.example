PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8080"
DATABASE_URL="postgresql://username:password@localhost:5432/multi-tenant_billing?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# OTP & SMS Gateway Configuration
DEFAULT_OTP="123456"
USE_DEFAULT_OTP="true"
SMS_PROVIDER="TRUEBULKSMS"
TRUEBULKSMS_USERNAME="your_username"
TRUEBULKSMS_PASSWORD=your_password
TRUEBULKSMS_SENDER_ID="SOFTFY"
TRUEBULKSMS_ROUTE="4"
TRUEBULKSMS_API_URL="http://truebulksms.biz/httpapi.php"
# TRUEBULKSMS_TEMPLATE_ID="YOUR_DLT_TEMPLATE_ID"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
