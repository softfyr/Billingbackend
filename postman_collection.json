            {
              "name": "2. Verify OTP Login (Auto Vendor Onboarding)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "if (jsonData.success && (jsonData.data.accessToken || jsonData.data.token)) {",
                      "    var t = jsonData.data.accessToken || jsonData.data.token;",
                      "    var r = jsonData.data.refreshToken;",
                      "    pm.collectionVariables.set('vendorToken', t);",
                      "    pm.collectionVariables.set('accessToken', t);",
                      "    if (r) pm.collectionVariables.set('refreshToken', r);",
                      "    if (jsonData.data.tenant && jsonData.data.tenant.id) {",
                      "        pm.collectionVariables.set('tenantId', jsonData.data.tenant.id);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"mobileNumber\": \"9876543210\",\n  \"otpCode\": \"123456\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/verify-otp",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "verify-otp"]
                }
              }
            },
